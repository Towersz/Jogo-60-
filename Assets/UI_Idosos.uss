/* =====================================================================
   UI_Idosos.uss  -  JOGO DE MERCADO (funcionário) - mobile retrato, público 60+
   Resolução de referência (Panel Settings):
   Scale With Screen Size, 1080 x 1920, Match = 0 (largura)
   (1080 px de largura equivalem a cerca de 360 dp: 52 px = 17 dp)

   Composição mobile
   - uma coluna só, pensada para uma mão: ações principais embaixo
   - "Voltar" sempre no rodapé, ao alcance do polegar
   - menu com barra de abas inferior (Mercado, Perfil, Ajustes)
   - pausa e saída como "bottom sheet" (painel que sobe de baixo)
   - nenhum alvo de toque menor que 150 px (50 dp)

   Identidade visual (tema: mercado)
   - toldo listrado vermelho e rosa no topo de todas as telas
   - valores em "etiquetas de preço", cartaz azul de instruções, fitas dos postos
   - crachá de funcionário no perfil
   - fundo escuro azul com formas da paleta (mosaico da imagem de referência)
   - botões "doces" em 3D: faixa grossa embaixo e afundam ao toque
   - cartões claros com texto escuro, contraste mínimo 4.5:1
   - texto, ícone de cor e palavra juntos: nunca só cor
   ===================================================================== */

:root {
    /* ---- Paleta (imagem de referência) ---- */
    --red-pale: #FFCDBF;
    --red-light: #FF7F6A;
    --red-main: #EE4E2F;
    --red-dark: #B31F0A;
    --red-deep: #561000;

    --blue-light: #3D8BE0;
    --blue-mid: #0F6BD1;
    --blue-main: #0B4A8A;
    --blue-dark: #0A3566;
    --blue-deep: #021A38;

    --lime-pale: #DDFF77;
    --lime-light: #BAF22D;
    --lime-main: #A3E000;
    --lime-dark: #6F9700;
    --lime-deep: #172500;

    /* ---- Neutros ---- */
    --surface: #FFF6F2;
    --white: #FFFFFF;
    --disabled-bg: #DCD6D3;
    --disabled-edge: #9A928E;
    --disabled-text: #4A4543;

    /* ---- Áreas seguras (notch e barra de gestos) ---- */
    --safe-top: 64px;
    --safe-bottom: 48px;
    /* topo das telas = área segura (64) + altura visível do toldo (126) */
    --screen-top: 190px;

    /* ---- Tamanhos de texto (mudam com .text-lg / .text-xl) ---- */
    --fs-small: 44px;
    --fs-body: 52px;
    --fs-button: 56px;
    --fs-subtitle: 68px;
    --fs-title: 100px;
}

.text-lg {
    --fs-small: 48px;
    --fs-body: 58px;
    --fs-button: 62px;
    --fs-subtitle: 74px;
    --fs-title: 108px;
}

.text-xl {
    --fs-small: 54px;
    --fs-body: 64px;
    --fs-button: 68px;
    --fs-subtitle: 80px;
    --fs-title: 116px;
}

/* ---------- Base ---------- */
.app-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--blue-deep);
    color: var(--white);
    font-size: var(--fs-body);
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    background-color: var(--blue-deep);
    padding-top: var(--screen-top);
    padding-bottom: var(--safe-bottom);
    overflow: hidden;
}

.screen.active {
    display: flex;
}

.center {
    align-items: center;
    justify-content: center;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.stretch {
    align-self: stretch;
}

/* ---------- Estrutura de tela: topo, conteúdo, rodapé ---------- */
.topbar {
    align-items: center;
    justify-content: center;
    padding: 24px 36px 12px 36px;
}

.topbar-title {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
}

.topbar-greeting {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--lime-main);
    -unity-text-align: middle-center;
    white-space: normal;
}

.content {
    flex-grow: 1;
    padding: 12px 36px;
    align-items: stretch;
    justify-content: flex-start;
}

.content.center {
    align-items: center;
    justify-content: center;
}

.bottombar {
    padding: 12px 36px 12px 36px;
    align-items: stretch;
}

/* ---------- Formas decorativas do fundo (mosaico da paleta) ---------- */
.deco {
    position: absolute;
    border-radius: 56px;
    opacity: 0.24;
}

.deco-1 {
    width: 520px;
    height: 520px;
    left: -170px;
    top: 220px;
    background-color: var(--red-main);
    rotate: 18deg;
}

.deco-2 {
    width: 440px;
    height: 440px;
    right: -150px;
    bottom: 420px;
    background-color: var(--lime-main);
    rotate: -14deg;
}

.deco-3 {
    width: 300px;
    height: 300px;
    right: -90px;
    top: 90px;
    background-color: var(--blue-light);
    rotate: 24deg;
}

/* ---------- Marca do jogo (composição da imagem de referência) ---------- */
.logo-mark {
    width: 320px;
    height: 320px;
    margin: 24px;
    border-radius: 48px;
    border-width: 8px;
    border-color: var(--white);
    overflow: hidden;
}

.logo-big {
    width: 460px;
    height: 460px;
}

.logo-row-top {
    flex-direction: row;
    height: 60%;
}

.logo-row-bottom {
    flex-direction: row;
    height: 40%;
}

.cell-l {
    width: 60%;
    height: 100%;
}

.cell-r {
    width: 40%;
    height: 100%;
}

.lc-red {
    background-color: var(--red-main);
}

.lc-blue {
    background-color: var(--blue-main);
}

.lc-lime {
    background-color: var(--lime-main);
}

.logo-mini {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 6px;
}

.mini-a {
    left: 22px;
    top: 22px;
    background-color: var(--red-light);
}

.mini-b {
    left: 66px;
    top: 22px;
    background-color: var(--red-pale);
}

.mini-c {
    right: 18px;
    top: 22px;
    background-color: var(--blue-light);
}

.mini-d {
    left: 22px;
    bottom: 18px;
    background-color: var(--lime-pale);
}

.mini-e {
    left: 66px;
    bottom: 18px;
    background-color: var(--lime-light);
}

/* ---------- Textos ---------- */
.title {
    font-size: var(--fs-title);
    -unity-font-style: bold;
    color: var(--lime-main);
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0px 8px 0px #172500;
    margin: 12px;
}

.subtitle {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 10px;
}

.body {
    font-size: var(--fs-body);
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    margin: 8px;
}

.body-left,
.text-left {
    -unity-text-align: middle-left;
}

.strong {
    -unity-font-style: bold;
}

.small {
    font-size: var(--fs-small);
}

/* Texto escuro dentro de cartões e painéis claros */
.card .subtitle,
.dialog .subtitle {
    color: var(--blue-main);
}

.card .body,
.dialog .body {
    color: var(--blue-deep);
}

.dialog .title {
    color: var(--blue-main);
    text-shadow: 0px 0px 0px #FFF6F2;
}

/* ---------- Botões "doces" em 3D ---------- */
.btn {
    min-width: 0;
    min-height: 160px;
    margin: 10px 0px;
    padding: 10px 28px;
    font-size: var(--fs-button);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    border-width: 0px;
    border-bottom-width: 14px;
    border-radius: 44px;
    border-color: var(--blue-dark);
    background-color: var(--blue-mid);
    color: var(--white);
    transition-property: translate, scale;
    transition-duration: 0.08s;
}

.btn:active {
    translate: 0px 10px;
    border-bottom-width: 4px;
}

.btn:focus {
    scale: 1.03 1.03;
    border-top-width: 6px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-color: var(--white);
    border-left-color: var(--white);
    border-right-color: var(--white);
}

.btn:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-edge);
    color: var(--disabled-text);
}

/* Ação principal (Jogar, Começar, Continuar, Comprar) */
.btn-primary {
    background-color: var(--lime-main);
    border-color: var(--lime-dark);
    color: var(--lime-deep);
}

/* Ação neutra (Voltar) */
.btn-ghost {
    background-color: var(--red-pale);
    border-color: var(--red-light);
    color: var(--blue-deep);
}

/* Ação destrutiva (Sair, Apagar) */
.btn-danger {
    background-color: var(--red-dark);
    border-color: var(--red-deep);
    color: var(--white);
}

.btn-block {
    align-self: stretch;
}

.btn-cta {
    min-height: 210px;
    font-size: 84px;
    border-radius: 60px;
    border-bottom-width: 20px;
}

.btn-buy {
    min-width: 300px;
    margin-left: 24px;
}

/* Barra de abas do menu */
.tabbar {
    flex-direction: row;
    align-items: stretch;
    background-color: var(--blue-dark);
    border-top-width: 8px;
    border-top-color: var(--lime-main);
    margin-top: 12px;
}

.btn-tab {
    flex-grow: 1;
    flex-basis: 0px;
    min-height: 180px;
    margin: 0px;
    padding: 6px 4px;
    font-size: var(--fs-small);
    border-bottom-width: 0px;
    border-radius: 0px;
    background-color: var(--blue-dark);
    color: var(--white);
    border-left-width: 3px;
    border-left-color: var(--blue-main);
}

.btn-tab:active {
    translate: 0px 0px;
    background-color: var(--blue-main);
    border-bottom-width: 0px;
}

/* Botões ligar/desligar (o texto também muda: "Ligado" / "Desligado") */
.toggle-on {
    background-color: var(--lime-main);
    border-color: var(--lime-dark);
    color: var(--lime-deep);
}

.toggle-off {
    background-color: var(--red-pale);
    border-color: var(--red-light);
    color: var(--blue-deep);
}

.btn-toggle {
    min-width: 330px;
    margin: 6px 0px;
}

/* Seleção atual (tamanho do texto) */
.selected {
    background-color: var(--lime-main);
    border-color: var(--lime-dark);
    color: var(--lime-deep);
}

.seg {
    flex-direction: row;
    align-self: stretch;
}

.seg .btn {
    flex-grow: 1;
    flex-basis: 0px;
    margin: 6px 6px;
    padding: 10px 6px;
}

/* ---------- Cartões, fichas e linhas ---------- */
.card {
    background-color: var(--surface);
    border-width: 6px;
    border-bottom-width: 16px;
    border-color: var(--blue-light);
    border-bottom-color: var(--blue-main);
    border-radius: 48px;
    padding: 28px 32px;
    margin: 12px 0px;
    align-items: center;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--blue-dark);
    border-width: 4px;
    border-color: var(--blue-light);
    border-radius: 60px;
    padding: 8px 30px 8px 18px;
    margin: 8px;
}

.chip-caption {
    font-size: var(--fs-small);
    color: var(--white);
    margin-right: 12px;
}

.chip-label {
    font-size: var(--fs-body);
    -unity-font-style: bold;
    color: var(--lime-main);
}

.dot {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 14px;
    border-width: 5px;
}

.dot-coin {
    background-color: var(--lime-main);
    border-color: var(--lime-dark);
}

.dot-customer {
    background-color: var(--red-main);
    border-color: var(--red-deep);
}

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    padding: 10px 0px;
    border-bottom-width: 3px;
    border-color: var(--red-pale);
}

.setting-block {
    align-self: stretch;
    padding: 10px 0px;
}

.setting-label {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--blue-dark);
    white-space: normal;
}

.price {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--red-dark);
    background-color: var(--lime-pale);
    border-width: 4px;
    border-color: var(--red-dark);
    border-radius: 20px;
    padding: 2px 22px;
    margin: 8px;
}

.avatar {
    width: 240px;
    height: 240px;
    border-radius: 120px;
    background-color: var(--red-main);
    border-width: 10px;
    border-color: var(--red-deep);
    align-items: center;
    justify-content: center;
    margin: 12px;
}

.avatar-letter {
    font-size: 130px;
    -unity-font-style: bold;
    color: var(--red-deep);
}

/* ---------- Barra de carregamento ---------- */
.progress-track {
    width: 82%;
    height: 72px;
    background-color: var(--blue-dark);
    border-width: 6px;
    border-color: var(--blue-light);
    border-radius: 40px;
    margin: 28px;
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: var(--lime-main);
    border-bottom-width: 12px;
    border-bottom-color: var(--lime-dark);
}

/* ---------- Mercado ---------- */
.market-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.market-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    align-items: flex-start;
}

.market-info .subtitle,
.market-info .body,
.market-info .price {
    -unity-text-align: middle-left;
    margin-left: 0px;
}

/* ---------- Seleção de fases (grade de 2 colunas) ---------- */
.grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
}

.level-card {
    width: 46%;
    min-height: 330px;
    margin: 2%;
    padding: 12px;
    align-items: center;
    justify-content: center;
    border-radius: 56px;
    border-bottom-width: 18px;
}

.level-number {
    font-size: 130px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-status {
    font-size: var(--fs-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-done {
    background-color: var(--lime-main);
    border-color: var(--lime-dark);
}

.level-done .level-number,
.level-done .level-status {
    color: var(--lime-deep);
}

.level-open {
    background-color: var(--blue-mid);
    border-color: var(--blue-dark);
}

.level-open .level-number,
.level-open .level-status {
    color: var(--white);
}

.level-locked {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-edge);
}

.level-locked .level-number,
.level-locked .level-status {
    color: var(--disabled-text);
}

.pill {
    background-color: var(--red-pale);
    border-width: 4px;
    border-color: var(--red-light);
    border-radius: 48px;
    padding: 8px 32px;
    margin: 8px;
    font-size: var(--fs-body);
    -unity-font-style: bold;
    color: var(--blue-deep);
}

/* ---------- Tema mercado: toldo, fitas, cartaz ---------- */
.awning {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 190px;
    flex-direction: row;
}

.awning-stripe {
    flex-grow: 1;
    flex-basis: 0px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
    border-bottom-width: 14px;
}

.as-red {
    background-color: var(--red-main);
    border-bottom-color: var(--red-dark);
}

.as-pale {
    background-color: var(--red-pale);
    border-bottom-color: var(--red-light);
}

.tagline {
    font-size: var(--fs-body);
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 4px 24px 12px 24px;
}

/* Fita do posto de trabalho (Caixa, Balança, Etiquetas) e do crachá */
.ribbon {
    align-self: center;
    background-color: var(--lime-pale);
    border-width: 4px;
    border-color: var(--lime-dark);
    border-radius: 40px;
    padding: 6px 36px;
    margin: 8px;
    font-size: var(--fs-body);
    -unity-font-style: bold;
    color: var(--blue-deep);
    -unity-text-align: middle-center;
}

/* Cartaz azul com a instrução do cliente */
.sign {
    align-items: center;
    background-color: var(--blue-main);
    border-width: 6px;
    border-bottom-width: 14px;
    border-color: var(--lime-main);
    border-bottom-color: var(--lime-dark);
    border-radius: 36px;
    padding: 20px 28px;
    margin: 12px 36px;
}

.sign .instruction {
    color: var(--white);
}

.level-caption {
    font-size: var(--fs-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-done .level-caption {
    color: var(--lime-deep);
}

.level-open .level-caption {
    color: var(--white);
}

.level-locked .level-caption {
    color: var(--disabled-text);
}

/* ---------- Jogo (topo, instrução e minigames) ---------- */
.hud {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 12px 36px;
}

.btn-pause {
    min-width: 250px;
    margin: 8px 0px;
}

.instruction-card {
    margin: 12px 36px;
    padding: 20px 28px;
}

.instruction {
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    color: var(--blue-deep);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0px;
}

.game-area {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
    padding: 12px 36px;
}

.minigame {
    display: none;
    align-items: stretch;
    justify-content: center;
}

.minigame.active {
    display: flex;
}

.answers {
    align-self: stretch;
}

.btn-answer {
    min-height: 190px;
    font-size: var(--fs-subtitle);
    margin: 14px 0px;
}

.slots {
    flex-direction: row;
    justify-content: center;
    margin: 16px;
}

.slot {
    width: 180px;
    height: 200px;
    margin: 8px;
    background-color: var(--surface);
    border-width: 6px;
    border-bottom-width: 14px;
    border-color: var(--blue-light);
    border-bottom-color: var(--blue-main);
    border-radius: 32px;
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--blue-deep);
}

.keypad {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
}

.key {
    width: 29%;
    min-height: 150px;
    margin: 1.5%;
    padding: 4px;
}

.tile {
    width: 21%;
    min-height: 200px;
    margin: 1%;
    font-size: 96px;
}

.tiles {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
}

/* Mensagem de resposta (sempre texto + cor) */
.feedback {
    display: none;
    align-self: stretch;
    padding: 18px 36px;
    margin: 12px 36px;
    border-width: 6px;
    border-radius: 44px;
    font-size: var(--fs-subtitle);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.feedback.show {
    display: flex;
}

.feedback-ok {
    background-color: var(--lime-main);
    color: var(--lime-deep);
    border-color: var(--lime-dark);
}

.feedback-error {
    background-color: var(--red-pale);
    color: var(--red-deep);
    border-color: var(--red-dark);
}

/* ---------- Painéis que sobem de baixo (Pausa, Confirmar saída) ---------- */
.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: stretch;
    justify-content: flex-end;
    background-color: rgba(2, 26, 56, 0.82);
}

.overlay.active {
    display: flex;
}

.dialog {
    align-self: stretch;
    background-color: var(--surface);
    border-top-width: 12px;
    border-top-color: var(--lime-main);
    border-top-left-radius: 72px;
    border-top-right-radius: 72px;
    padding: 24px 36px 80px 36px;
    align-items: stretch;
}

.sheet-handle {
    align-self: center;
    width: 140px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--red-light);
    margin-bottom: 12px;
}

/* ---------- Seleção de versão do fluxo (A ou B) ----------
   Mantenha estas regras por último.
   No elemento "app-root" use a classe version-a ou version-b. */
.version-a .only-b {
    display: none;
}

.version-b .only-a {
    display: none;
}
